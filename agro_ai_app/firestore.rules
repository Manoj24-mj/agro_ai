rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to check if a user exists during login
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
      
      // Allow user to read/write their own scans and chats
      match /scans/{scanId} {
        allow read, write: if true;
      }
      match /chats/{chatId} {
        allow read, write: if true;
      }
      match /searches/{searchId} {
        allow read, write: if true;
      }
      match /weather/{weatherId} {
        allow read, write: if true;
      }
    }
    
    // Allow creating general history
    match /history/{historyId} {
      allow read, write: if true;
    }
    
    // Default fallback (block everything else)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
